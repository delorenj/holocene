[Unit]
Description=Holocene Agent Pad roster (routable agents, most recently talked to first, avatars from Holocene)
Documentation=file://%h/code/33GOD/holocene/services/pad-roster/pad_roster.py
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/code/33GOD/holocene/services/pad-roster
ExecStart=/usr/bin/python3 -B %h/code/33GOD/holocene/services/pad-roster/pad_roster.py
# Reads Holocene's avatar store (~/.local/share/holocene/avatars); no secrets, no network.
Environment=PYTHONUNBUFFERED=1
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
# Output: ~/.local/share/holocene-auto/pad-roster/ (served at https://agent-pad.delo.sh/roster/)
TimeoutStartSec=300
