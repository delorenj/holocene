# RETIRED 2026-10-26: scheduling moved to candybar (33GOD/candybar deploy/migration/ledger.yaml,
# id systemd:holocene-pad-roster.timer). Kept for rollback only — never enable this timer.
[Unit]
Description=Refresh the Agent Pad roster every 2 minutes

[Timer]
OnBootSec=1min
OnUnitActiveSec=2min
AccuracySec=15s

[Install]
WantedBy=timers.target
