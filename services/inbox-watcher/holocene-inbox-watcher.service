[Unit]
Description=Holocene Auto voice memo pipeline (S3 inbox -> transcribe -> Bloodbank command -> spoken reply)
Documentation=file://%h/code/33GOD/holocene/services/inbox-watcher/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/code/33GOD/holocene/services/inbox-watcher
ExecStart=/usr/bin/python3 -u %h/code/33GOD/holocene/services/inbox-watcher/inbox_watcher.py
Restart=always
RestartSec=5
# S3 access comes from the `delo` mc alias in ~/.mc/config.json; no secrets live in this unit.
Environment=PYTHONUNBUFFERED=1
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
Environment=TRANSCRIBE_DIR=%h/HeyMa
Environment=MEMO_AGENT_TIMEOUT_S=600
Environment=MEMO_TRANSCRIBE_TIMEOUT_S=420
# interactive = invoke lane (reserved gateway slots); batch = start lane (rollback lever, no gateway restart)
Environment=MEMO_LANE=interactive
# Per-turn model routes are the code defaults (voice sol-6.1, follow-up the profile's own model, a desk delegation the voice model). Sonnet 5.5 was tried and rolled
# back 2026-10-22 (Anthropic 400s Hermes gateway turns); override with MEMO_VOICE_MODEL / MEMO_FOLLOWUP_MODEL only here.
# ---- the fast in-car conversation desk (HOLOC-23, converse.py; README "Fast conversation layer")
# Shipped OFF. `mise run memo:converse on|shadow|off [--agents a,b|'*'] [--devices id]` flips it at runtime through the
# flag file ~/.local/state/holocene-auto/inbox-watcher/converse.json (wins over these defaults, no restart).
Environment=MEMO_CONVERSE=off
Environment=MEMO_CONVERSE_AGENTS=holocene-pm
# empty = any car device; the sim pilot puts the emulator's device id here (or in the flag file)
Environment=MEMO_CONVERSE_DEVICES=
# another agent than the tile only when the driver said its name aloud and confirmed the read-back naming it (off: tile only)
Environment=MEMO_CONVERSE_HANDOFF=named
Environment=MEMO_CONVERSE_IDLE_S=900
Environment=MEMO_CONVERSE_DRAFT_TTL_S=600
# the sum of the rung timeouts (r1 4 + r2 5 + r3 7): r1 AND r2 timing out still leave r3 its full 7 s (it answers in
# 2.5-4.4 s). The budget only caps the all-slow case; a healthy turn ends at its first answer (r2 ~1.5 s).
Environment=MEMO_CONVERSE_BUDGET_S=16
Environment=MEMO_CONVERSE_TTS_STEPS=6
# The ladder, in order (operator decision 2026-10-22). Keys are op:// item-UUID references ONLY, read with `op read` at
# first use, kept in memory.
# r1: Hyper deepseek-v4.1-flash-1017 on the "Holocene Auto" key (OUT OF CREDIT until topped up: a 402 opens the rung for
#     10 min, so it is skipped in ~0.2 s and comes back by itself when credit returns).
# r2: DeepSeek's own API, deepseek-flash (= DeepSeek-V4.1-Flash), item "DeepSeek" field "API Key".
# r3: the subscriptions autorouter automaticai/auto/fast on the holocene-converse gateway token (id 88), whose scope holds no
#     Anthropic route, so auto's candidates (intersected with the scope) are glm-5.3-flash, kimi-k3s, glm-5.3, kimi-k3,
#     kimi-2.8, hypercharm/deepseek routes. temperature 1 (kimi 400s any other); no reasoning_effort (auto sets the rung's).
# Never Anthropic: bare automaticai/auto, /orchestrator, /subagent, openrouter/auto and any claude route are refused;
# automaticai/auto/fast and automaticai/free only on the token listed in MEMO_CONVERSE_SCOPED_KEY_REFS.
# Per tile, a model alias (car_desk_aliases.json; mise run memo:model <agent> <alias>) puts its routes in front of these.
Environment=MEMO_CONVERSE_SCOPED_KEY_REFS=op://DeLoSecrets/yeurk5dpqkaarspvsn3cjtmkki/holocene-converse
Environment='MEMO_CONVERSE_ROUTES=[{"id":"r1","base_url":"https://hyper.charm.land/v1","key_ref":"op://DeLoSecrets/qlnfw3xdnaxrelksmhnpqqolwe/credential","model":"deepseek-v4.1-flash-1017","timeout_s":4,"temperature":0.3},{"id":"r2","base_url":"https://api.deepseek.com","key_ref":"op://DeLoSecrets/35x5d67bgad73f6rypivp35gfa/oa3xka3ys6fhdgvumw7gztmyja","model":"deepseek-flash","timeout_s":5,"temperature":0.3,"max_tokens":1500},{"id":"r3","base_url":"https://api.automaticai.io/v1","key_ref":"op://DeLoSecrets/yeurk5dpqkaarspvsn3cjtmkki/holocene-converse","model":"automaticai/auto/fast","timeout_s":7,"temperature":1}]'
# The car desk's tools: the Skillex scope with the car-desk pack (car-set-voice, car-set-model), read at start-up and on change
Environment=MEMO_CONVERSE_TOOLS_DIR=%h/.local/state/holocene-auto/car-desk-scope
# All state is under ~/.local/state/holocene-auto/inbox-watcher/ (state.json, heartbeat.json)
TimeoutStopSec=30

[Install]
WantedBy=default.target
