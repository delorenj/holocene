[Unit]
Description=Holocene Auto voice memo pipeline (S3 inbox -> transcribe -> Bloodbank command -> spoken reply)
Documentation=file://%h/code/33GOD/holocene/services/inbox-watcher/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/code/33GOD/holocene/services/inbox-watcher
ExecStart=/usr/bin/python3 -u %h/code/33GOD/holocene/services/inbox-watcher/inbox_watcher.py
Restart=always
RestartSec=5
# S3 access comes from the `delo` mc alias in ~/.mc/config.json; no secrets live in this unit.
Environment=PYTHONUNBUFFERED=1
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
Environment=TRANSCRIBE_DIR=%h/HeyMa
Environment=MEMO_AGENT_TIMEOUT_S=600
Environment=MEMO_TRANSCRIBE_TIMEOUT_S=420
# interactive = invoke lane (reserved gateway slots); batch = start lane (rollback lever, no gateway restart)
Environment=MEMO_LANE=interactive
# Per-turn model routes are the code defaults (voice sol-6.1, follow-up the profile's own model). Sonnet 5.5 was tried and rolled
# back 2026-10-22 (Anthropic 400s Hermes gateway turns); override with MEMO_VOICE_MODEL / MEMO_FOLLOWUP_MODEL only here.
# ---- the fast in-car conversation desk (HOLOC-23, converse.py; README "Fast conversation layer")
# Shipped OFF. `mise run memo:converse on|shadow|off [--agents a,b|'*'] [--devices id]` flips it at runtime through the
# flag file ~/.local/state/holocene-auto/inbox-watcher/converse.json (wins over these defaults, no restart).
Environment=MEMO_CONVERSE=off
Environment=MEMO_CONVERSE_AGENTS=holocene-pm
# empty = any car device; the sim pilot puts the emulator's device id here (or in the flag file)
Environment=MEMO_CONVERSE_DEVICES=
# another agent than the tile only when the driver said its name aloud and confirmed the read-back naming it (off: tile only)
Environment=MEMO_CONVERSE_HANDOFF=named
Environment=MEMO_CONVERSE_IDLE_S=900
Environment=MEMO_CONVERSE_DRAFT_TTL_S=600
Environment=MEMO_CONVERSE_BUDGET_S=8
Environment=MEMO_CONVERSE_TTS_STEPS=6
# The ladder, in order. Keys are op:// item-UUID references ONLY, read with `op read` at first use, kept in memory.
# r1/r2: Hyper direct (shared with Hindsight until a dedicated key exists, AAI-53; OUT OF CREDIT since 2026-10-22, a 402 opens
# the rung for 10 min). r3m/r3c/r3a/r3b: the AutomaticAI gateway token holocene-converse (scope exactly ministral-14b,
# gemini-3.5-flash-lite, kimi-k3s, glm-5.3-flash). Never Anthropic, never automaticai/auto: such a route is refused.
# Bench: r1 p50 0.94 s / p90 1.41 s; r2 2.5 s; r3m ministral-14b 1.0 s; r3c gemini-3.5-flash-lite 0.8 s (spiky);
# r3a kimi-k3s at medium 4.05 s (temperature must be 1); r3b 7.7 s.
Environment='MEMO_CONVERSE_ROUTES=[{"id":"r1","base_url":"https://hyper.charm.land/v1","key_ref":"op://DeLoSecrets/tflaecgcrdgxrh2ovgi5ysjkzq/credential","model":"deepseek-v4.1-flash-1017","timeout_s":4,"temperature":0.3},{"id":"r2","base_url":"https://hyper.charm.land/v1","key_ref":"op://DeLoSecrets/tflaecgcrdgxrh2ovgi5ysjkzq/credential","model":"deepseek-v4.1-flash","timeout_s":4,"temperature":0.3},{"id":"r3m","base_url":"https://api.automaticai.io/v1","key_ref":"op://DeLoSecrets/yeurk5dpqkaarspvsn3cjtmkki/holocene-converse","model":"automaticai/mistral-allowance/ministral-14b","timeout_s":3,"temperature":0.3},{"id":"r3c","base_url":"https://api.automaticai.io/v1","key_ref":"op://DeLoSecrets/yeurk5dpqkaarspvsn3cjtmkki/holocene-converse","model":"automaticai/gemini-free/gemini-3.5-flash-lite","timeout_s":3,"temperature":0.3},{"id":"r3a","base_url":"https://api.automaticai.io/v1","key_ref":"op://DeLoSecrets/yeurk5dpqkaarspvsn3cjtmkki/holocene-converse","model":"automaticai/personal/kimi-k3s","timeout_s":5,"temperature":1,"reasoning_effort":"medium"},{"id":"r3b","base_url":"https://api.automaticai.io/v1","key_ref":"op://DeLoSecrets/yeurk5dpqkaarspvsn3cjtmkki/holocene-converse","model":"automaticai/personal/glm-5.3-flash","timeout_s":5,"temperature":0.3,"reasoning_effort":"medium"}]'
# All state is under ~/.local/state/holocene-auto/inbox-watcher/ (state.json, heartbeat.json)
TimeoutStopSec=30

[Install]
WantedBy=default.target
