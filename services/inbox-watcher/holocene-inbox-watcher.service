[Unit]
Description=Holocene Auto voice memo pipeline (S3 inbox -> transcribe -> Bloodbank command -> spoken reply)
Documentation=file://%h/code/33GOD/holocene/services/inbox-watcher/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/code/33GOD/holocene/services/inbox-watcher
ExecStart=/usr/bin/python3 -u %h/code/33GOD/holocene/services/inbox-watcher/inbox_watcher.py
Restart=always
RestartSec=5
# S3 access comes from the `delo` mc alias in ~/.mc/config.json; no secrets live in this unit.
Environment=PYTHONUNBUFFERED=1
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
Environment=TRANSCRIBE_DIR=%h/HeyMa
Environment=MEMO_AGENT_TIMEOUT_S=600
Environment=MEMO_TRANSCRIBE_TIMEOUT_S=420
# interactive = invoke lane (reserved gateway slots); batch = start lane (rollback lever, no gateway restart)
Environment=MEMO_LANE=interactive
# Per-turn model routes are the code defaults (voice sol-6.1, follow-up the profile's own model, a desk delegation the voice model). Sonnet 5.5 was tried and rolled
# back 2026-10-22 (Anthropic 400s Hermes gateway turns); override with MEMO_VOICE_MODEL / MEMO_FOLLOWUP_MODEL only here.
# ---- the fast in-car conversation desk (HOLOC-23, converse.py; README "Fast conversation layer")
# ON for every tile and car since 2026-10-22 (operator). `mise run memo:converse on|shadow|off [--agents a,b|'*'] [--devices id]`
# flips it at runtime through the flag file ~/.local/state/holocene-auto/inbox-watcher/converse.json (wins over these defaults, no restart).
Environment=MEMO_CONVERSE=on
Environment=MEMO_CONVERSE_AGENTS=*
# empty = any car device; the sim pilot puts the emulator's device id here (or in the flag file)
Environment=MEMO_CONVERSE_DEVICES=
# another agent than the tile only when the driver said its name aloud and confirmed the read-back naming it (off: tile only)
Environment=MEMO_CONVERSE_HANDOFF=named
Environment=MEMO_CONVERSE_IDLE_S=900
Environment=MEMO_CONVERSE_DRAFT_TTL_S=600
# One route, so the budget is that route's timeout plus slack (never below it). A healthy turn ends at the first answer
# (aai/auto/fast measured 7-9 s on 2026-10-22; the 12 s timeout is its tail). When it fails the watcher falls through to
# the full-agent path; that is the only fallback the default has. A tile alias (car_desk_aliases.json) puts its own routes
# in front and carries its own budget_s.
Environment=MEMO_CONVERSE_BUDGET_S=14
Environment=MEMO_CONVERSE_TTS_STEPS=6
# ---- latency levers (HOLOC-23 phase 2; README "Latency levers"). Each one falls back to the old behaviour on its own.
# S3 over the local MinIO port (the mc alias `delodrive`, same buckets as `delo` = s3.delo.sh through Cloudflare): mc cp up
# 7.1 s p50 / down 3.5 s p50 via Cloudflare vs 0.14 s / 0.07 s here, measured under load. MEMO_S3_DIRECT=1 serves the hot-path
# calls (cp, ls, stat, cat, pipe) in-process on a kept-alive SigV4 connection (65 ms up, 18 ms down, 3 ms stat); mc runs anything else.
Environment=MEMO_S3_ALIAS=delodrive
Environment=MEMO_S3_DIRECT=1
# received / transcribed / voiced published by one ordered thread instead of a bb-emit subprocess in the path (0.16-0.25 s each)
Environment=MEMO_FACTS_ASYNC=1
Environment=MEMO_PUSH_HINT_URL=http://127.0.0.1:8698/internal/push
# the desk's fixed lines ("Dropped. Nothing was sent." ...) are rendered once per voice and kept in <state>/phrases/
Environment=MEMO_PHRASEBANK=1
# a thread lists inbox/ every 0.4 s (0.1 s per listing, no process) and starts a new memo at once; the proxy's wake hint is faster still
Environment=MEMO_DISCOVER_FAST_S=0.4
# the fast reply's chunk caps. No gap between chunks needs chunk n+1's render <= chunk n's playing time. vox renders ~1.6 s +
# 0.018 s/char at 6 steps and speaks ~0.051 s/char, so c(n+1) <= 2.8 c(n) - 89: 55 -> 65 -> 95 -> 180 -> 300. (45,80 left a
# 0.7-1.3 s pause after a 2.3 s first beat while the 69-93 char second chunk rendered in 3.2-3.4 s; HOLOC-23 review.)
# Replies under 60 characters stay one piece.
Environment=MEMO_CONVERSE_CHUNK_CHARS=55,65,95,180,300
Environment=MEMO_CONVERSE_CHUNK_MIN_CHARS=60
# The default is ONE route (operator decision 2026-10-22: "use aai/auto/fast and its existing fallback chain, no pinned model
# or gateway rebuild"): automaticai/auto/fast on api.automaticai.io with the Claude-free holocene-converse token (id 88).
# The gateway does the fallback: its auto chain (fast tier -> strong tier -> free last resort, intersected with the token's
# scope) picks the model, e.g. automaticai/personal/glm-5.3. Keys are op:// item-UUID references ONLY, read with `op read`
# at first use, kept in memory. temperature 1 (kimi 400s any other); no reasoning_effort (auto sets the rung's).
# Never Anthropic, three checks: (1) the token's scope proof (GET /models lists no Anthropic id; re-checked every 10 min),
# (2) the served route's X-AutomaticAI-Route header must not be Anthropic, (3) the response `model` must not be Anthropic.
# Bare automaticai/auto, /orchestrator, /subagent, openrouter/auto and any claude route are refused;
# automaticai/auto/fast and automaticai/free only on the token listed in MEMO_CONVERSE_SCOPED_KEY_REFS.
# A pinned model is an opt-in per tile, never the default: the Hyper and DeepSeek routes live in car_desk_aliases.json
# (deepseek-flash, deepseek-pro; mise run memo:model <agent> <alias>) and go in front of this route for that tile only.
Environment=MEMO_CONVERSE_SCOPED_KEY_REFS=op://DeLoSecrets/yeurk5dpqkaarspvsn3cjtmkki/holocene-converse
Environment='MEMO_CONVERSE_ROUTES=[{"id":"r1","base_url":"https://api.automaticai.io/v1","key_ref":"op://DeLoSecrets/yeurk5dpqkaarspvsn3cjtmkki/holocene-converse","model":"automaticai/auto/fast","timeout_s":12,"temperature":1}]'
# auto/fast serves this token glm-5.3 at effort max whatever the request says (an explicit reasoning_effort medium was
# logged as requested xhigh, 2026-10-22), so a long-answer request can spend the whole max_tokens (700) on reasoning and
# come back empty / cut (finish_reason length, outcome "truncated"). The last rung is then re-asked ONCE for the short
# version when at least this much of MEMO_CONVERSE_BUDGET_S is left (0 = off); measured re-asks took 2.9-5.1 s. A larger
# max_tokens is no fix: the cut then lands at 12-16 s, past the budget (converse-e2e/final-regression.md, "Fixes").
Environment=MEMO_CONVERSE_REASK_MIN_S=2.5
# The car desk's tools: the Skillex scope with the car-desk pack (car-set-voice, car-set-model), read at start-up and on change
Environment=MEMO_CONVERSE_TOOLS_DIR=%h/.local/state/holocene-auto/car-desk-scope
# All state is under ~/.local/state/holocene-auto/inbox-watcher/ (state.json, heartbeat.json)
TimeoutStopSec=30

[Install]
WantedBy=default.target
