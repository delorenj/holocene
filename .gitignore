node_modules
.pnpm-store
.turbo
.next
dist
coverage
.env*

# Secrets — .env is materialized by `op inject -i .env.op > .env` on mise enter.
# NEVER commit it. .env.op holds only 1Password references or safe literals and IS committed.
.env
.env.*
!.env.op

# PJAN-82: generated skill projections are never tracked
# sync-skills.py, provision-packs.py and bmad-method rewrite these on every
# run. No trailing slash: some CLIs get a real directory here, some a symlink.
.claude/skills
.codex/skills
.gemini/skills
.copilot/skills
.opencode/skills
.kimi-code/skills
.crush/skills
.cursor/skills
.agents/skills

# Generated CLI configurations are durable project state...
!.claude/
!.claude/**
!.codex/
!.codex/**
!.gemini/
!.gemini/**
!.copilot/
!.copilot/**
!.opencode/
!.opencode/**
!.kimi-code/
!.kimi-code/**
# ...but their skill projections are regenerated by `bmad-method install` and
# `mise run skills:sync`, so they stay out of the tree. No trailing slash:
# some CLIs get a real directory here and some get a symlink.
/.agents/skills
.claude/skills
.codex/skills
.gemini/skills
.copilot/skills
.opencode/skills
.kimi-code/skills
