node_modules
.pnpm-store
.turbo
.next
dist
coverage
.env*

# Secrets — .env is materialized by `op inject -i .env.op > .env` on mise enter.
# NEVER commit it. .env.op holds only 1Password references or safe literals and IS committed.
.env
.env.*
!.env.op

# PJAN-82: generated skill projections are never tracked
# sync-skills.py, provision-packs.py and bmad-method rewrite these on every
# run. No trailing slash: some CLIs get a real directory here, some a symlink.
.crush/skills
.cursor/skills
.agents/skills

# Canonical agent config lives in .agents; generated skill projections stay local.
/.agents/skills

# Generated TypeScript incremental state
*.tsbuildinfo

# Agent Pad / reply-player / inbox-watcher: build output and runtime state
apps/agent-pad/dist/
apps/agent-pad/node_modules/
apps/reply-player/.gradle/
apps/reply-player/**/build/
apps/reply-player/.kotlin/
apps/reply-player/local.properties
apps/reply-player/**/*.apk
services/inbox-watcher/inbox-watcher-state.json
