<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- WebView/Chromium needs this to select the capture device for getUserMedia -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
    <application android:label="Holocene Auto" android:theme="@style/AppTheme"
        android:allowBackup="false" android:supportsRtl="true">
        <!-- Optional car API: present on automotive builds, absent on phones.
             Declared optional so non-automotive devices install and run; all
             android.car.* usage is isolated in CarHost.kt and fails closed. -->
        <uses-library
            android:name="android.car"
            android:required="false" />
        <activity android:name=".MainActivity" android:exported="true">
            <!-- Agent Pad has a driving layout (big tiles, steering-wheel control, spoken feedback, no text, no motion),
                 so the OS keeps this activity in front while the car moves. AAOS honours the tag only for apps
                 installed by a trusted source (Honda: com.android.vending); Play policy allows it on the internal
                 and closed tracks only. Never promote a build carrying it to open testing or production. -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
